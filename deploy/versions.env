# Pinned image references (CLAUDE.md Dependency Rules: no floating tags for
# anything security-relevant). Every image is referenced by immutable digest.
#
# This file is also the deployment source of the image/build values that go
# into each locked execution configuration (engineering plan assumption A7);
# those entries are added in the phases that introduce the sandbox image and
# the gateway build.
#
# Use with: docker compose --env-file deploy/versions.env ...
POSTGRES_IMAGE=postgres:16.10-alpine@sha256:029660641a0cfc575b14f336ba448fb8a75fd595d42e1fa316b9fb4378742297
# Cowrie SSH honeypot 3.0.15 (multi-arch index digest; runs as UID 999). Used only
# by the honeypot-isolation profile single-host and by the separate honeypot host.
COWRIE_IMAGE=cowrie/cowrie:3.0.15@sha256:fc57120d88c2bfb5817f63f6c132ce5c2969b641c2f1ac67887652b6f294148d
